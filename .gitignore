*.tmp
*.temp

# AI tools (future-proofing)
.openai/
.claude/
.llama/

# Merge conflict backups  
*.orig  
  
# Editor backups  
*.bak  
*.backup  
  
# Crash dumps  
*.dmp  
*.stackdump  
  
